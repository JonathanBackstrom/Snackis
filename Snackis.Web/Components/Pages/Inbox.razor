@page "/account/messages"
@attribute [Authorize]
@rendermode InteractiveServer

@inject NavigationManager Navigation
@inject IConversationService ConversationService

@using System.Security.Claims

<PageTitle>Meddelanden</PageTitle>

<h1>Meddelanden</h1>

@if (conversations is null)
{
    <p>Laddar...</p>
}
else if (conversations.Count == 0)
{
    <p>Du har inga meddelanden än.</p>
}
else
{
    <ul>
        @foreach (var conversation in conversations)
        {
            <li>
                <a href="/account/messages/@conversation.Id">@conversation.Title</a>

                @if (conversation.UnreadCount > 0)
                {
                    <strong>(@conversation.UnreadCount nya)</strong>
                }

                @if (conversation.LastMessage is not null)
                {
                    <p>@conversation.LastMessage · @conversation.LastMessageAt?.ToLocalTime().ToString("g")</p>
                }
            </li>
        }
    </ul>
}

<h2>Ny grupp</h2>

<EditForm Model="newGroup" OnValidSubmit="HandleCreateGroup">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <p>
        <label>
            Gruppnamn <br />
            <InputText @bind-Value="newGroup.Name" />
        </label>
    </p>

    <button type="submit">Skapa grupp</button>
</EditForm>

@if (error is not null)
{
    <p class="text-danger">@error</p>
}

@code {
    [CascadingParameter]
    public Task<AuthenticationState>? AuthState { get; set; }
    private CreateGroupDto newGroup = new();
    private string? userId;
    private string? error;

    private IReadOnlyList<ConversationListDto>? conversations;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState!;
        userId = state.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        conversations = await ConversationService.GetInboxAsync(userId!);
    }

    private async Task HandleCreateGroup()
    {
        error = null;

        try
        {
            var id = await ConversationService.CreateGroupAsync(newGroup, userId!);
            Navigation.NavigateTo($"/account/messages/{id}");
        }
        catch (Exception ex) when (ex is BusinessRuleException or NotFoundException)
        {
            error = ex.Message;
        }
    }
}
