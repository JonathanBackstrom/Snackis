@page "/categories/{Id:int}"
@inject IDiscussionService DiscussionService
@inject ICategoryService CategoryService

<PageTitle>Kategori</PageTitle>
<h1>@category?.Name</h1>

@if (category is null || discussions is null)
{
    <p>Laddar...</p>
}
else if (discussions.Count == 0)
{
    <p>Inga diskussioner ännu.</p>
}
else
{
    <ul>
        @foreach (var discussion in discussions)
        {
            <li>
                <a href="/discussions/@discussion.Id">@discussion.Title</a>
                @if (discussion.IsLocked)
                {
                    <span>(låst)</span>
                }
                <p>@discussion.AuthorName · @discussion.CreatedAt.ToLocalTime().ToString("g")</p>
            </li>
        }
    </ul>
}
<AuthorizeView>
    <Authorized>
        <a href="/categories/@Id/new">Ny tråd</a>
    </Authorized>
    <NotAuthorized>
        <p><a href="/Account/Login">Logga in</a> för att skapa en tråd.</p>
    </NotAuthorized>
</AuthorizeView>




@code
{
    [Parameter]
    public int Id { get; set; }

    private CategoryDto? category;
    private IReadOnlyList<DiscussionListDto>? discussions;

    protected override async Task OnInitializedAsync() => await LoadAsync();
    

    public async Task LoadAsync()
    {
        discussions = await DiscussionService.GetByCategoryAsync(Id);
        category = await CategoryService.GetByIdAsync(Id);
    }
}
