@page "/admin/categories"

@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer
@inject ICategoryService CategoryService

<PageTitle>Kategorier</PageTitle>

<h1>Kategorier</h1>


@if (categories is null)
{
    <p>Laddar...</p>
}
else if (categories.Count == 0)
{
    <p>Inga kategorier ännu.</p>
}
else
{
    <ul>
        @foreach (var category in categories)
        {
            <li>
                @category.Name

                <button @onclick="() => StartEdit(category.Id)">Redigera</button>
                <button @onclick="() => HandleDelete(category.Id)">Radera</button>

                @if (category.SubCategories.Count > 0)
                {
                    <ul>
                        @foreach (var sub in category.SubCategories)
                        {
                            <li>@sub.Name</li>

                            <button @onclick="() => StartEdit(sub.Id)">Redigera</button>
                            <button @onclick="() => HandleDelete(sub.Id)">Radera</button>
                        }
                    </ul>
                }
            </li>
        }
    </ul>

    @if (editCategory is not null)
    {
        <h2>Redigera kategori</h2>

        <EditForm Model="editCategory" OnValidSubmit="HandleUpdate">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <p>
                <label>
                    Namn<br />
                    <InputText @bind-Value="editCategory.Name" />
                </label>
            </p>
            <p>
                <label>
                    Beskrivning<br />
                    <InputTextArea @bind-Value="editCategory.Description" />
                </label>
            </p>

            <button type="submit">Spara</button>
            <button type="button" @onclick="() => editCategory = null">Avbryt</button>
        </EditForm>
    }
}

<h2>Ny kategori</h2>

<EditForm Model="newCategory" OnValidSubmit="HandleCreate">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <p>
        <label>
            Namn<br />
            <InputText @bind-Value="newCategory.Name" />
        </label>
    </p>
    <p>
        <label>
            Beskrivning<br />
            <InputTextArea @bind-Value="newCategory.Description" />
        </label>
    </p>
    <p>
        <label>
            Förälder<br />
            <InputSelect @bind-Value="newCategory.ParentCategoryId">
                <option value="">— Toppnivå —</option>
                @foreach (var parent in topLevel ?? [])
                {
                    <option value="@parent.Id">@parent.Name</option>
                }
            </InputSelect>
        </label>
    </p>
    <button type="submit">Skapa</button>
</EditForm>

@if (error is not null)
{
    <p class="text-danger">@error</p>
}


@code 
{
    private IReadOnlyList<CategoryDto>? categories;
    private CreateCategoryDto newCategory = new();
    private IReadOnlyList<CategoryDto>? topLevel;
    private UpdateCategoryDto? editCategory;
    private string? error;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        categories = await CategoryService.GetTreeAsync();
        topLevel = await CategoryService.GetTopLevelAsync();
    }

    private async Task HandleCreate()
    {
        error = null;

        try
        {
            await CategoryService.CreateAsync(newCategory);
            newCategory = new();
            await LoadAsync();
        }
        catch (Exception ex) when (ex is BusinessRuleException or NotFoundException)
        {
            error = ex.Message;
        }
    }

    private async Task HandleUpdate()
    {
        error = null;

        try
        {
            await CategoryService.UpdateAsync(editCategory!);
            editCategory = null;
            await LoadAsync();
        }
        catch (Exception ex) when (ex is BusinessRuleException or NotFoundException)
        {
            error = ex.Message;
        }
    }

    private async Task HandleDelete(int id)
    {
        error = null;

        try
        {
            await CategoryService.DeleteAsync(id);
            await LoadAsync();
        }
        catch (Exception ex) when (ex is BusinessRuleException or NotFoundException)
        {
            error = ex.Message;
        }
    }

    private async Task StartEdit(int id)
    {
        error = null;
        editCategory = await CategoryService.GetForEditAsync(id);
    }
}
