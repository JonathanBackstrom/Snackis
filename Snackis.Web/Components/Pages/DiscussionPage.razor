@page "/discussions/{Id:int}"

@rendermode InteractiveServer
@inject IDiscussionService DiscussionService
@inject IPostService PostService
@inject IReportService ReportService
@inject IReactionService ReactionService
@inject NavigationManager Navigation

<PageTitle>@discussion?.Title</PageTitle>

@if (notFound)
{
    <p>Tråden finns inte längre.</p>
    <p><a href="/forum">Tillbaka till forumet</a></p>
}
else if (discussion is null)
{
    <p>Laddar...</p>
}
else
{

    <p><a href="/categories/@discussion.CategoryId">@discussion.CategoryName</a></p>
    <h1>@discussion.Title</h1>
    @if (isAdmin)
    {
        <p class="admin-bar">
            <button @onclick="ToggleLock">
                @(discussion.IsLocked ? "Lås upp tråden" : "Lås tråden")
            </button>

            <button @onclick="DeleteClicked">
                @(confirmDelete ? "Klicka igen för att ta bort" : "Ta bort tråden")
            </button>
        </p>
    }


    @if (discussion.IsLocked)
    {
        <p><strong>Tråden är låst av en moderator.</strong></p>
    }

    @foreach (var post in discussion.Posts)
    {
        <PostNode Post="post"
                  CurrentUserId="@userId"
                  IsAdmin="isAdmin"
                  IsLocked="discussion.IsLocked"
                  OnReply="StartReply"
                  OnReport="StartReport"
                  OnReact="HandleReact"/>
    }
    <AuthorizeView Context="auth">
        <Authorized>
            @if (!discussion.IsLocked)
            {
                <EditForm Model="newPost" OnValidSubmit="HandleReply">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    @if (replyToPostId is not null)
                    {
                        <p>
                            Svarar på inlägg #@replyToPostId
                            <button type="button" @onclick="() => replyToPostId = null">Avbryt</button>
                        </p>
                    }

                    <p>
                        <InputTextArea @bind-Value="newPost.Body" rows="4" />
                    </p>

                    <p>
                        <InputFile OnChange="HandleFiles" accept="image/*" multiple />
                    </p>

                    <button type="submit">Svara</button>
                </EditForm>
            }
        </Authorized>
        <NotAuthorized>
            <p><a href="/Account/Login">Logga in</a> för att svara.</p>
        </NotAuthorized>
    </AuthorizeView>

    @if (reportPostId is not null)
    {
        <EditForm Model="newReport" OnValidSubmit="HandleReport">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <h2>Anmäl inlägg</h2>

            <p>
                <label>
                    Varför anmäler du inlägget?<br />
                    <InputTextArea @bind-Value="newReport.Reason" rows="3" />
                </label>
            </p>

            <button type="submit">Skicka anmälan</button>
            <button type="button" @onclick="() => reportPostId = null">Avbryt</button>
        </EditForm>
    }

    @if (message is not null)
    {
        <p>@message</p>
    }

    @if (error is not null)
    {
        <p class="text-danger">@error</p>
    }
}

