@page "/discussions/{Id:int}"

@rendermode InteractiveServer
@inject IDiscussionService DiscussionService
@inject IPostService PostService
@inject IReportService ReportService
@inject IReactionService ReactionService

@using System.Security.Claims
@using Snackis.Application.Validation

<PageTitle>@discussion?.Title</PageTitle>

@if (discussion is null)
{
    <p>Laddar...</p>
}
else
{
    <p><a href="/categories/@discussion.CategoryId">@discussion.CategoryName</a></p>
    <h1>@discussion.Title</h1>

    @if (discussion.IsLocked)
    {
        <p><strong>Tråden är låst av en moderator.</strong></p>
    }

    @foreach (var post in discussion.Posts)
    {
        <PostNode Post="post"
                  CurrentUserId="@userId"
                  IsAdmin="isAdmin"
                  IsLocked="discussion.IsLocked"
                  OnReply="StartReply"
                  OnReport="StartReport"
                  OnReact="HandleReact"/>
    }
    <AuthorizeView Context="auth">
        <Authorized>
            @if (!discussion.IsLocked)
            {
                <EditForm Model="newPost" OnValidSubmit="HandleReply">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    @if (replyToPostId is not null)
                    {
                        <p>
                            Svarar på inlägg #@replyToPostId
                            <button type="button" @onclick="() => replyToPostId = null">Avbryt</button>
                        </p>
                    }

                    <p>
                        <InputTextArea @bind-Value="newPost.Body" rows="4" />
                    </p>

                    <p>
                        <InputFile OnChange="HandleFiles" accept="image/*" multiple />
                    </p>

                    <button type="submit">Svara</button>
                </EditForm>
            }
        </Authorized>
        <NotAuthorized>
            <p><a href="/Account/Login">Logga in</a> för att svara.</p>
        </NotAuthorized>
    </AuthorizeView>

    @if (reportPostId is not null)
    {
        <EditForm Model="newReport" OnValidSubmit="HandleReport">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <h2>Anmäl inlägg</h2>

            <p>
                <label>
                    Varför anmäler du inlägget?<br />
                    <InputTextArea @bind-Value="newReport.Reason" rows="3" />
                </label>
            </p>

            <button type="submit">Skicka anmälan</button>
            <button type="button" @onclick="() => reportPostId = null">Avbryt</button>
        </EditForm>
    }

    @if (message is not null)
    {
        <p>@message</p>
    }

    @if (error is not null)
    {
        <p class="text-danger">@error</p>
    }
}

@code
{
    [CascadingParameter]
    public Task<AuthenticationState>? AuthState { get; set; }

    [Parameter]
    public int Id { get; set; }

    private DiscussionDetailDto? discussion;
    private string? userId;
    private bool isAdmin;
    private CreatePostDto newPost = new();
    private string? error;
    private int? replyToPostId;
    private int? reportPostId;
    private CreateReportDto newReport = new();
    private string? message;
    private IReadOnlyList<IBrowserFile> selectedFiles = [];

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState!;
        userId = state.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        isAdmin = state.User.IsInRole("Admin");

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        discussion = await DiscussionService.GetDetailAsync(Id, userId);
    }

    private void StartReply(int postId)
    {
        replyToPostId = postId;
        error = null;

        error = null;
        message = null;
    }

    private async Task HandleReply()
    {
        error = null;

        try
        {
            newPost.DiscussionId = Id;
            newPost.ParentPostId = replyToPostId;

            var postId = await PostService.CreateAsync(newPost, userId!);

            foreach (var fil in selectedFiles)
            {
                await using var stream = fil.OpenReadStream(maxAllowedSize: 2 * 1024 * 1024);
                await PostService.AddImageAsync(postId, stream, fil.Name, fil.Size, userId!);
            }

            newPost = new();
            selectedFiles = [];
            replyToPostId = null;

            await LoadAsync();
        }
        catch (IOException)
        {
            error = "Inlägget skapades, men en bild kunde inte laddas upp.";
        }
        catch (Exception ex) when (ex is BusinessRuleException or NotFoundException)
        {
            error = ex.Message;
        }
    }

    private void StartReport(int postID)
    {
        reportPostId = postID;
        newReport = new() { PostId = postID };
        replyToPostId = null;

        error = null;
        message = null;
    }

    private async Task HandleReport()
    {
        error = null;
        try
        {
            await ReportService.CreateAsync(newReport, userId!);

            reportPostId = null;
            newReport = new();
            message = "Tack, din anmälan har skickats till moderatorerna.";
        }
        catch (Exception ex) when (ex is BusinessRuleException or NotFoundException)
        {
            error = ex.Message;
        }
    }

    private async Task HandleReact((int PostId, ReactionType type) reaction)
    {
        error = null;

        try
        {
            await ReactionService.ReactAsync(reaction.PostId, userId!, reaction.type);
            await LoadAsync();
        }
        catch (Exception ex) when (ex is BusinessRuleException or NotFoundException)
        {
            error = ex.Message;
        }
    }

    private void HandleFiles(InputFileChangeEventArgs e)
    {
        error = null;
        selectedFiles = [];

        try
        {
            var files = e.GetMultipleFiles(maximumFileCount: 4);

            foreach (var file in files)
            {
                ImageRules.Validate(file.Name, file.Size);
            }

            selectedFiles = files;
        }
        catch (BusinessRuleException ex)
        {
            error = ex.Message;
        }
    }
}