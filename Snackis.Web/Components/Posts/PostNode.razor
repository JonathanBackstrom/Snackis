<article>
    @if (Post.AvatarPath is not null)
    {
        <img src="@Post.AvatarPath" alt="" width="48" height="48" />
    }
    <p>

        <a href="/users/@Post.AuthorId">@Post.AuthorName</a> · @Post.CreatedAt.ToLocalTime().ToString("g")
        @if (Post.EditedAt is not null)
        {
            <em>(redigerad)</em>
        }
    </p>
    @if (Post.IsDeleted)
    {
        <p><em>[Inlägg borttaget]</em></p>
    }
    else
    {
        <p>@Post.Body</p>

        @if (Post.ImagePaths is { Count: > 0 })
        {
            <div class="post-images">
                @foreach (var path in Post.ImagePaths)
                {
                    <img src="@path" alt="" />
                }
            </div>
        }
    }
    @if (!Post.IsDeleted)
    {
        <div class="reactions">
            @foreach (var typ in reaktioner)
            {
                var antal = Post.ReactionCounts?.GetValueOrDefault(typ) ?? 0;

                <button class="@(Post.MyReaction == typ ? "reaction active" : "reaction")"
                        disabled="@(CurrentUserId is null)"
                        @onclick="() => OnReact.InvokeAsync((Post.Id, typ))">
                    @Etikett(typ)@(antal > 0 ? $" {antal}" : "")
                </button>
            }
        </div>
    }
    @if (CurrentUserId is not null && !IsLocked && !Post.IsDeleted)
    {
        <button @onclick="() => OnReply.InvokeAsync(Post.Id)">Svara</button>
    }

    @if (CurrentUserId is not null && Post.AuthorId != CurrentUserId && !Post.IsDeleted)
    {
        <button @onclick="() => OnReport.InvokeAsync(Post.Id)">Anmäl</button>
    }
</article>

    @foreach (var reply in Post.Replies)
    {
        <PostNode Post="reply"
                  CurrentUserId="@CurrentUserId"
                  IsAdmin="IsAdmin"
                  IsLocked="IsLocked"
                  OnReply="OnReply"
                  OnReport="OnReport"
                  OnReact="OnReact"/>
    }


@code {
    [Parameter]
    public PostDto Post { get; set; } = default!;

    [Parameter]
    public string? CurrentUserId { get; set; }

    [Parameter]
    public bool IsAdmin { get; set; }

    [Parameter]
    public bool IsLocked { get; set; }

    [Parameter]
    public EventCallback<int> OnReply { get; set; }

    [Parameter]
    public EventCallback<int> OnReport { get; set; }

    [Parameter]
    public EventCallback<(int PostId, ReactionType Type)> OnReact { get; set; }

    private static readonly ReactionType[] reaktioner =
[
    ReactionType.Like, ReactionType.Dislike, ReactionType.Love,
    ReactionType.Haha, ReactionType.Wow, ReactionType.Sad, ReactionType.Angry
];

    private static string Etikett(ReactionType type) => type switch
    {
        ReactionType.Like => "👍",
        ReactionType.Dislike => "👎",
        ReactionType.Love => "❤️",
        ReactionType.Haha => "😄",
        ReactionType.Wow => "😮",
        ReactionType.Sad => "😢",
        ReactionType.Angry => "😠",
        _ => "?"
    };
}