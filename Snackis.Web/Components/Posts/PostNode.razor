<article>
    @if (Post.AvatarPath is not null)
    {
        <img src="@Post.AvatarPath" alt="" width="48" height="48" />
    }
    <p>

        <a href="/users/@Post.AuthorId">@Post.AuthorName</a> · @Post.CreatedAt.ToLocalTime().ToString("g")
        @if (Post.EditedAt is not null)
        {
            <em>(redigerad)</em>
        }
    </p>

    @if (Post.IsDeleted)
    {
        <p><em>[Inlägg borttaget]</em></p>
    }
    else
    {
        <p>@Post.Body</p>
    }
    @if (CurrentUserId is not null && !IsLocked && !Post.IsDeleted)
    {
        <button @onclick="() => OnReply.InvokeAsync(Post.Id)">Svara</button>
    }

    @if (CurrentUserId is not null && Post.AuthorId != CurrentUserId && !Post.IsDeleted)
    {
        <button @onclick="() => OnReport.InvokeAsync(Post.Id)">Anmäl</button>
    }
</article>

    @foreach (var reply in Post.Replies)
    {
        <PostNode Post="reply"
                  CurrentUserId="@CurrentUserId"
                  IsAdmin="IsAdmin"
                  IsLocked="IsLocked"
                  OnReply="OnReply"
                  OnReport="OnReport" />
    }


@code {
    [Parameter]
    public PostDto Post { get; set; } = default!;

    [Parameter]
    public string? CurrentUserId { get; set; }

    [Parameter]
    public bool IsAdmin { get; set; }

    [Parameter]
    public bool IsLocked { get; set; }

    [Parameter]
    public EventCallback<int> OnReply { get; set; }

    [Parameter]
    public EventCallback<int> OnReport { get; set; }
}